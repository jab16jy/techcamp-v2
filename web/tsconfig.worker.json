{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    // The service worker is NOT part of the app program: `lib` here is
    // `WebWorker` instead of `DOM`, and loading both into one program collides
    // on hundreds of shared declarations. `tsconfig.app.json` excludes this
    // file for the same reason.
    "lib": ["ES2023", "WebWorker"],
    "module": "esnext",
    "types": [],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/features/push/sw.ts", "src/features/push/pushPayload.ts"]
}
